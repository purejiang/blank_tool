{
  "name": "branch-demo",
  "version": "1.0",
  "description": "Composition-based if/else: count regex matches, compare the count with a threshold, and run one of two sub-workflow templates (builtin-only, zero external dependencies)",
  "inputs": [
    {"name": "target", "type": {"base": "text"}, "required": true, "description": "File or directory to scan"},
    {"name": "pattern", "type": {"base": "text"}, "required": true, "description": "Regular expression whose matching lines are counted"},
    {"name": "threshold", "type": {"base": "number"}, "required": true, "description": "Count above this value takes the high branch"}
  ],
  "outputs": [
    {"name": "passed", "type": {"base": "boolean"}, "required": true, "description": "True when the selected branch completed"}
  ],
  "nodes": [
    {
      "id": "scan",
      "tool": "text.grep",
      "params": {
        "path": "$inputs.target",
        "pattern": "$inputs.pattern"
      },
      "next": "decide"
    },
    {
      "id": "decide",
      "tool": "flow.compare",
      "params": {
        "a": "$nodes.scan.outputs.count",
        "b": "$inputs.threshold",
        "op": "gt"
      },
      "next": "route"
    },
    {
      "id": "route",
      "tool": "flow.branch",
      "params": {
        "condition": "$nodes.decide.outputs.result",
        "true_template": "branch-high",
        "false_template": "branch-low",
        "inputs": {
          "target": "$inputs.target",
          "pattern": "$inputs.pattern",
          "count": "$nodes.scan.outputs.count"
        }
      },
      "next": "done"
    },
    {
      "id": "done",
      "tool": "flow.assert",
      "params": {
        "condition": true,
        "message": "branch finished"
      },
      "next": null
    }
  ]
}
