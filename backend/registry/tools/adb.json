{
  "name": "adb",
  "display_name": "Android Debug Bridge",
  "type": "binary",
  "path": {
    "win": "adb/adb.exe",
    "mac": "adb/adb",
    "linux": "adb/adb"
  },
  "env_deps": [],
  "validate": {
    "cmd": ["version"],
    "expect_contains": "Android Debug Bridge",
    "expect_in": "stdout",
    "expect_returncode": 0
  },
  "version": {
    "cmd": ["version"],
    "regex": "(\\d+\\.\\d+\\.\\d+)",
    "from_stream": "stdout"
  },
  "inputs": [
    {
      "name": "args",
      "type": {
        "base": "text"
      },
      "required": false,
      "description": "Arguments to pass to adb"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": {
        "base": "json"
      },
      "required": true,
      "description": "Command result with returncode, stdout, stderr"
    }
  ]
}
