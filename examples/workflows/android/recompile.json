{
  "name": "recompile",
  "version": "1.0",
  "description": "Build an APK from a decompiled source tree using apktool.",
  "inputs": [
    {
      "name": "source_dir",
      "type": {
        "base": "directory",
        "subtype": null
      },
      "required": true,
      "description": "Path to the decompiled source directory to build from."
    },
    {
      "name": "output_apk",
      "type": {
        "base": "file",
        "subtype": "apk"
      },
      "required": false,
      "description": "Path to write the built APK to (default: $workdir/<basename>.apk)."
    }
  ],
  "outputs": [
    {
      "name": "output_apk",
      "type": {
        "base": "file",
        "subtype": "apk"
      },
      "required": true,
      "description": "Path to the built APK."
    }
  ],
  "nodes": [
    {
      "id": "recompile",
      "type": "step",
      "tool": "apktool",
      "params": {
        "args": [
          "b",
          "$inputs.source_dir",
          "-o",
          "$inputs.output_apk"
        ]
      },
      "next": null,
      "on_success": null,
      "on_failure": "fail",
      "condition": null,
      "retry": 0
    }
  ],
  "edges": []
}
