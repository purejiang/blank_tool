{
  "name": "sign",
  "version": "1.0",
  "description": "Align an APK with zipalign, then sign it with apksigner.",
  "inputs": [
    {
      "name": "apk_path",
      "type": {
        "base": "file",
        "subtype": "apk"
      },
      "required": true,
      "description": "Path to the APK file to align and sign."
    },
    {
      "name": "keystore",
      "type": {
        "base": "json",
        "subtype": null
      },
      "required": true,
      "description": "Signing keystore config with fields: path, alias, storepass, keypass."
    }
  ],
  "outputs": [
    {
      "name": "signed_apk",
      "type": {
        "base": "file",
        "subtype": "apk"
      },
      "required": true,
      "description": "Path to the aligned and signed APK."
    }
  ],
  "nodes": [
    {
      "id": "align",
      "type": "step",
      "tool": "zipalign",
      "params": {
        "operation": "align",
        "input_apk": "$inputs.apk_path",
        "output_apk": "$workdir/aligned.apk",
        "force": true
      },
      "next": "sign",
      "on_success": null,
      "on_failure": "fail",
      "condition": null,
      "retry": 0
    },
    {
      "id": "sign",
      "type": "step",
      "tool": "apksigner",
      "params": {
        "operation": "sign",
        "apk_path": "$workdir/aligned.apk",
        "ks_path": "$inputs.keystore.path",
        "ks_key_alias": "$inputs.keystore.alias",
        "ks_pass": "pass:$inputs.keystore.storepass"
      },
      "next": null,
      "on_success": null,
      "on_failure": "fail",
      "condition": null,
      "retry": 0
    }
  ],
  "edges": []
}
