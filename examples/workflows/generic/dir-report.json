{
  "name": "dir-report",
  "version": "1.0",
  "description": "Scan a directory, log the entry count, and write a report file (builtin-only, zero external dependencies)",
  "inputs": [
    {"name": "target_dir", "type": {"base": "text"}, "required": true, "description": "Directory path to scan"}
  ],
  "outputs": [
    {"name": "passed", "type": {"base": "boolean"}, "required": true, "description": "True when the workflow completes successfully"}
  ],
  "nodes": [
    {
      "id": "list",
      "tool": "dir.list",
      "params": {
        "path": "$inputs.target_dir"
      },
      "next": "log_count"
    },
    {
      "id": "log_count",
      "tool": "flow.log",
      "params": {
        "message": "$nodes.list.outputs.count",
        "level": "info"
      },
      "next": "write_report"
    },
    {
      "id": "write_report",
      "tool": "file.write",
      "params": {
        "path": "dir-report.txt",
        "content": "Directory scan complete."
      },
      "next": "final_assert",
      "on_failure": "fail"
    },
    {
      "id": "final_assert",
      "tool": "flow.assert",
      "params": {
        "condition": true,
        "message": "Report generated successfully"
      },
      "next": null
    }
  ],
  "edges": []
}
