{
  "name": "adb",
  "display_name": "Android Debug Bridge",
  "type": "binary",
  "path": {
    "win": "adb/adb.exe",
    "mac": "adb/adb",
    "linux": "adb/adb"
  },
  "env_deps": [],
  "validate": {
    "cmd": ["version"],
    "expect_contains": "Android Debug Bridge",
    "expect_in": "stdout",
    "expect_returncode": 0
  },
  "version": {
    "cmd": ["version"],
    "regex": "(\\d+\\.\\d+\\.\\d+)",
    "from_stream": "stdout"
  },
  "inputs": [
    {
      "name": "args",
      "type": {
        "base": "text"
      },
      "required": false,
      "description": "Arguments to pass to adb"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": {
        "base": "json"
      },
      "required": true,
      "description": "Command result with returncode, stdout, stderr"
    }
  ],
  "operations": [
    {
      "name": "install",
      "description": "Install an APK on a device (adb install).",
      "inputs": [
        {
          "name": "apk_path",
          "type": { "base": "file", "subtype": "apk" },
          "required": true,
          "description": "Path to the APK file to install."
        },
        {
          "name": "reinstall",
          "type": { "base": "boolean" },
          "required": false,
          "description": "Reinstall the app, keeping its data (-r flag)."
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type": { "base": "json" },
          "required": true,
          "description": "Command result with returncode, stdout, stderr."
        }
      ],
      "args_map": [
        "install",
        { "flag": "reinstall", "value": "-r" },
        { "param": "apk_path" }
      ]
    },
    {
      "name": "passthrough",
      "description": "Run arbitrary adb arguments (generic fallback).",
      "inputs": [
        {
          "name": "args",
          "type": { "base": "text" },
          "required": true,
          "description": "Raw adb arguments as a space-separated string."
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type": { "base": "json" },
          "required": true,
          "description": "Command result with returncode, stdout, stderr."
        }
      ],
      "args_map": [
        { "param": "args" }
      ]
    }
  ]
}
