{
  "name": "apksigner",
  "display_name": "Apksigner",
  "type": {
    "win": "java_jar",
    "mac": "binary",
    "linux": "binary"
  },
  "path": {
    "win": "android/apksigner.jar",
    "mac": "android/apksigner",
    "linux": "android/apksigner"
  },
  "env_deps": ["java"],
  "validate": {
    "cmd": ["--help"],
    "expect_contains": "apksigner",
    "expect_in": "stdout",
    "expect_returncode": 0
  },
  "version": {
    "cmd": ["version"],
    "regex": "(\\d[\\d\\.\\-]+)",
    "from_stream": "stdout"
  },
  "inputs": [
    {
      "name": "args",
      "type": {
        "base": "text"
      },
      "required": false,
      "description": "Arguments to pass to apksigner"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": {
        "base": "json"
      },
      "required": true,
      "description": "Command result with returncode, stdout, stderr"
    }
  ],
  "operations": [
    {
      "name": "sign",
      "description": "Sign an APK with a keystore (apksigner sign).",
      "inputs": [
        {
          "name": "apk_path",
          "type": { "base": "file", "subtype": "apk" },
          "required": true,
          "description": "Path to the APK to sign."
        },
        {
          "name": "ks_path",
          "type": { "base": "file" },
          "required": true,
          "description": "Path to the keystore file."
        },
        {
          "name": "ks_key_alias",
          "type": { "base": "text" },
          "required": true,
          "description": "Key alias within the keystore."
        },
        {
          "name": "ks_pass",
          "type": { "base": "text" },
          "required": true,
          "description": "Keystore password (with pass: prefix)."
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type": { "base": "json" },
          "required": true,
          "description": "Command result with returncode, stdout, stderr."
        }
      ],
      "args_map": [
        "sign",
        "--ks",
        { "param": "ks_path" },
        "--ks-key-alias",
        { "param": "ks_key_alias" },
        "--ks-pass",
        { "param": "ks_pass" },
        { "param": "apk_path" }
      ]
    }
  ]
}
