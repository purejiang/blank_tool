{
  "name": "apksigner",
  "display_name": "Apksigner",
  "type": {
    "win": "java_jar",
    "mac": "binary",
    "linux": "binary"
  },
  "path": {
    "win": "android/apksigner.jar",
    "mac": "android/apksigner",
    "linux": "android/apksigner"
  },
  "env_deps": ["java"],
  "validate": {
    "cmd": ["--help"],
    "expect_contains": "apksigner",
    "expect_in": "stdout",
    "expect_returncode": 0
  },
  "version": {
    "cmd": ["version"],
    "regex": "(\\d[\\d\\.\\-]+)",
    "from_stream": "stdout"
  },
  "inputs": [
    {
      "name": "args",
      "type": {
        "base": "text"
      },
      "required": false,
      "description": "Arguments to pass to apksigner"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": {
        "base": "json"
      },
      "required": true,
      "description": "Command result with returncode, stdout, stderr"
    }
  ]
}
