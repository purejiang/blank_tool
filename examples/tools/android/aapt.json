{
  "name": "aapt",
  "display_name": "Android Asset Packaging Tool",
  "type": "binary",
  "path": {
    "win": "aapt/aapt2.exe",
    "mac": "aapt/aapt2",
    "linux": "aapt/aapt2"
  },
  "env_deps": [],
  "validate": {
    "cmd": ["version"],
    "expect_contains": "aapt",
    "expect_in": "either",
    "expect_returncode": 0
  },
  "version": {
    "cmd": ["version"],
    "regex": "(\\d[\\d\\.\\-]+)",
    "from_stream": "either"
  },
  "inputs": [
    {
      "name": "args",
      "type": {
        "base": "text"
      },
      "required": false,
      "description": "Arguments to pass to aapt"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": {
        "base": "json"
      },
      "required": true,
      "description": "Command result with returncode, stdout, stderr"
    }
  ]
}
